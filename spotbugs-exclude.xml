<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Discord payloads and persisted text use LF on every OS; %n would make Windows output differ. -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <!-- Spring supplies the shared mutable service by dependency injection. -->
    <Match>
        <Class name="dev.skullition.lockium.command.OwnerCommands"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The JDA application emoji is intentionally returned as a framework value. -->
    <Match>
        <Class name="dev.skullition.lockium.model.ClothingType"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
